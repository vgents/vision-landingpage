# Copie para .env.local (nunca versionado). Variáveis VITE_* vão para o bundle: só valores públicos.

# Chave PÚBLICA do Mercado Pago para o Card Payment Brick (/compra/pagar).
# TEST-... no sandbox, APP_USR-... em produção. Sem ela, só o Pix funciona.
VITE_MP_PUBLIC_KEY=

# Opcional: origem dos instaladores, sem barra no fim.
# VITE_DOWNLOAD_ORIGIN=
